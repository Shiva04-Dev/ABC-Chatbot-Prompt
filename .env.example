# Copy to .env and fill in real values only when Shiv supplies them (see CLAUDE.md Section 10).
# All values below are placeholders — the app must run with these as-is (no real calls yet).

AZURE_OPENAI_ENDPOINT=https://PLACEHOLDER.openai.azure.com/
AZURE_OPENAI_API_KEY=PLACEHOLDER-api-key
AZURE_OPENAI_DEPLOYMENT=PLACEHOLDER-deployment-name
AZURE_OPENAI_API_VERSION=PLACEHOLDER-api-version

# Comma-separated exact frontend origins to allow via CORS, e.g. the real
# production domain once one exists. Leave empty until there's a concrete
# origin to add.
CORS_ALLOWED_ORIGINS=

# Regex for origins to allow via CORS in addition to CORS_ALLOWED_ORIGINS.
# Defaults (in code) to allowing any *.vercel.app deployment — production
# and preview builds alike — which covers M7's test UI. Override only if
# you need to narrow or change this.
# CORS_ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$
